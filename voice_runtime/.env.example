# Copy to .env and edit (never commit .env):
#   cp .env.example .env
#
# Loaded by scripts/ensure_running.sh and scripts/run_mac.sh
# for any variable that is not already set in the shell / Flutter.

# TTS engine: chatterbox_nano | chatterbox_turbo | chatterbox_mtl_v3 | kokoro
VOICE_TTS_BACKEND=chatterbox_nano

# Optional: force CPU / mps / cuda for Chatterbox
# VOICE_TTS_DEVICE=mps

# Optional: custom >5s WAV for Chatterbox voice cloning
# VOICE_TTS_REFERENCE=/absolute/path/to/ref.wav

# Optional: default language for chatterbox_mtl_v3
# VOICE_TTS_LANGUAGE=en

# Loopback bind (keep 127.0.0.1 for local-only)
VOICE_RUNTIME_HOST=127.0.0.1
VOICE_RUNTIME_PORT=8765

# Whisper model size for STT
WHISPER_MODEL=tiny

# Selected voice catalog id (preferred):
#   kokoro:af_heart  — built-in Kokoro preset
#   ref:my_clone     — WAV under VOICE_REFERENCES_DIR / ~/.uncensored-ai/voice/references
# VOICE_TTS_VOICE=kokoro:af_heart

# Kokoro voice preset (legacy; used when VOICE_TTS_VOICE unset)
VOICE_PRESET=af_heart
# VOICE_TTS_SPEED=0.92

# Folder for custom clone WAVs (Chatterbox). Defaults to ~/.uncensored-ai/voice/references
# VOICE_REFERENCES_DIR=/absolute/path/to/wavs

